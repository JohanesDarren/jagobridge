# ================================================================
# APPLICATION
# ================================================================
APP_NAME=jagobridge
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                         # false in staging and production
APP_SECRET_KEY=change-me-min-32-characters-random-value
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Jakarta

# ================================================================
# SERVER
# ================================================================
PORT=5000

# ================================================================
# DATABASE
# ================================================================
DATABASE_URL=postgresql://jago:jago@localhost:5440/jagobridge
PGUSER=jago
PGHOST=localhost
PGDATABASE=jagobridge
PGPASSWORD=jago
PGPORT=5440
PGPOOL_MIN=2
PGPOOL_MAX=10

# ================================================================
# REDIS
# ================================================================
REDIS_URL=redis://localhost:6380/0

# ================================================================
# JWT / AUTH
# ================================================================
JWT_SECRET_KEY=change-me-jwt-secret-different-from-app-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
INVITATION_EXPIRE_HOURS=72
BCRYPT_COST=12

# ================================================================
# UPSTREAM: 9ROUTER
# ================================================================
UPSTREAM_BASE_URL=https://9router.jagoai.dev/v1
UPSTREAM_API_KEY=
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_FIRST_BYTE_TIMEOUT_SECONDS=60
UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=60
MODEL_SYNC_INTERVAL_MINUTES=60

# ================================================================
# GATEWAY SAFETY
# ================================================================
GATEWAY_ENABLED=true
MAX_INFLIGHT_REQUESTS_PER_USER=5
USAGE_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
PLAYGROUND_RETENTION_DAYS=90
PLAYGROUND_UPLOAD_DIR=./data/uploads
PLAYGROUND_MAX_UPLOAD_MB=5

# ================================================================
# EMAIL (SMTP)
# ================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JagoBridge <no-reply@team.example>

# ================================================================
# MONITORING
# ================================================================
SENTRY_DSN=
LOG_LEVEL=INFO
